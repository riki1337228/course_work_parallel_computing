# Copy to `.env` to override defaults. Every variable is optional:
# `docker compose up` works without a .env file.

# ---------------------------------------------------------------- host port
SERVER_PORT=8080

# ---------------------------------------------------------------- dataset (dataset-init)
# 20 000 documents, ~2 GiB. For a quick demo use e.g. 10000 / 256.
DATASET_DOCUMENTS=20000
DATASET_TARGET_MB=2048
DATASET_SEED=42

# ---------------------------------------------------------------- search server
INDEX_THREADS=8
REQUEST_THREADS=16
IO_THREADS=4
MAX_INDEX_THREADS=64
DEFAULT_LIMIT=10
MAX_LIMIT=100
EXPANDED_TERM_WEIGHT=0.5
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SEC=60
MAX_EXPANSION_TERMS=6
